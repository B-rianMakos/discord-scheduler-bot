DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here

# Channel the bot reads for new events, tasks, and reminders (right-click channel → Copy ID)
SCHEDULE_CHANNEL_ID=

# IANA timezone for the 5:00 AM daily job (e.g. America/New_York)
CRON_TIMEZONE=America/New_York

# Morning ping: @everyone in the schedule channel (set to false to post with no mention)
NOTIFY_EVERYONE=true
